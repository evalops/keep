# Secret management utilities
# Include this in your main Makefile or run directly

.PHONY: secrets-build secrets-get secrets-set secrets-migrate secrets-init

# Build the secrets CLI tool
secrets-build:
	go build -o bin/secrets ./cmd/secrets

# Get a secret (requires KEY)
secrets-get: secrets-build
	@if [ -z "$(KEY)" ]; then echo "Usage: make secrets-get KEY=secret-name"; exit 1; fi
	./bin/secrets -action=get -key=$(KEY)

# Set a secret (requires KEY and VALUE)
secrets-set: secrets-build
	@if [ -z "$(KEY)" ] || [ -z "$(VALUE)" ]; then echo "Usage: make secrets-set KEY=secret-name VALUE=secret-value"; exit 1; fi
	./bin/secrets -action=set -key=$(KEY) -value=$(VALUE)

# List available secrets
secrets-list: secrets-build
	./bin/secrets -action=list

# Migrate from environment to specified provider
secrets-migrate: secrets-build
	@if [ -z "$(TYPE)" ]; then echo "Usage: make secrets-migrate TYPE=[ssm|vault|azure]"; exit 1; fi
	./bin/secrets -action=migrate -type=$(TYPE)

# Initialize setup for a provider
secrets-init: secrets-build
	@if [ -z "$(TYPE)" ]; then echo "Usage: make secrets-init TYPE=[ssm|vault|azure]"; exit 1; fi
	./bin/secrets -action=init -type=$(TYPE)

# Convenience targets for specific providers

# AWS SSM shortcuts
secrets-ssm-get:
	$(MAKE) secrets-get TYPE=ssm KEY=$(KEY)

secrets-ssm-set:
	$(MAKE) secrets-set TYPE=ssm KEY=$(KEY) VALUE=$(VALUE)

secrets-ssm-migrate:
	$(MAKE) secrets-migrate TYPE=ssm

# Vault shortcuts
secrets-vault-get:
	$(MAKE) secrets-get TYPE=vault KEY=$(KEY)

secrets-vault-set:
	$(MAKE) secrets-set TYPE=vault KEY=$(KEY) VALUE=$(VALUE)

secrets-vault-migrate:
	$(MAKE) secrets-migrate TYPE=vault

# Azure shortcuts
secrets-azure-get:
	$(MAKE) secrets-get TYPE=azure KEY=$(KEY)

secrets-azure-set:
	$(MAKE) secrets-set TYPE=azure KEY=$(KEY) VALUE=$(VALUE)

secrets-azure-migrate:
	$(MAKE) secrets-migrate TYPE=azure

# Development helpers
secrets-dev-setup:
	@echo "Setting up development secrets..."
	@echo "POSTGRES_PASSWORD=dev-password" >> .env
	@echo "GOOGLE_CLIENT_ID=dev-client-id.apps.googleusercontent.com" >> .env
	@echo "JWT_SIGNING_KEY=dev-jwt-key" >> .env
	@echo "Development secrets added to .env file"

secrets-prod-setup:
	@echo "Production secret management setup:"
	@echo "1. Choose your secret manager: make secrets-init TYPE=[ssm|vault|azure]"
	@echo "2. Migrate existing secrets: make secrets-migrate TYPE=[ssm|vault|azure]"
	@echo "3. Update your .env file with SECRET_MANAGER_TYPE=[ssm|vault|azure]"
	@echo "4. Configure provider-specific settings (see docs/SECRET_MANAGEMENT.md)"

# Test secret management
secrets-test: secrets-build
	@echo "Testing secret management..."
	@export TEST_SECRET=test-value-123 && \
	./bin/secrets -action=get -key=TEST_SECRET -type=env && \
	echo "✓ Environment variable secrets working"

secrets-help:
	@echo "Secret Management Commands:"
	@echo ""
	@echo "  secrets-build         Build the secrets CLI tool"
	@echo "  secrets-get           Get a secret (requires KEY=name)"
	@echo "  secrets-set           Set a secret (requires KEY=name VALUE=value)"  
	@echo "  secrets-list          List available secrets"
	@echo "  secrets-migrate       Migrate from env vars (requires TYPE=provider)"
	@echo "  secrets-init          Initialize provider setup (requires TYPE=provider)"
	@echo ""
	@echo "Provider-specific shortcuts:"
	@echo "  secrets-ssm-get       Get secret from AWS SSM"
	@echo "  secrets-vault-get     Get secret from Vault"
	@echo "  secrets-azure-get     Get secret from Azure Key Vault"
	@echo ""
	@echo "Setup commands:"
	@echo "  secrets-dev-setup     Create development .env file"
	@echo "  secrets-prod-setup    Show production setup instructions"
	@echo "  secrets-test          Test secret management functionality"
	@echo ""
	@echo "Examples:"
	@echo "  make secrets-get KEY=POSTGRES_PASSWORD"
	@echo "  make secrets-set KEY=API_KEY VALUE=abc123"
	@echo "  make secrets-ssm-migrate"
	@echo "  make secrets-init TYPE=vault"
